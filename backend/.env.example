DATABASE_URL=postgresql+psycopg://xiaxin:123456@127.0.0.1:5432/tomato_agent
APP_ENV=development
JWT_SECRET_KEY=dev-only-change-me-with-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 后续提供真实 API 后启用。未配置时，工具会返回结构化降级结果，不影响本地流程验证。
LLM_PROVIDER=openai
AGENT_DECISION_MODE=llm
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_TEXT_MODEL=gpt-5.5
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-v4-pro
VISION_PROVIDER=openai
OPENAI_VISION_MODEL=gpt-5.5
WEATHER_API_KEY=
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:8000,http://127.0.0.1:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://127.0.0.1:5174

# OAuth 登录后续接入时使用。需要先在 Google/GitHub 创建 OAuth App。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
